# Fest Vibes Beta Environment Variables
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# USER DATABASE
# =============================================================================
# Neon PostgreSQL Database Connection String
# Get this from: https://neon.tech (free tier available)
# Format: postgresql://username:password@hostname/database_name
NEON_DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# Venues Database Configuration (separate database for venue data, probably also on neondb)
V0_DATABASE_URL="postgresql://username:password@host/venues_database?sslmode=require"

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
# Your domain for the Fest Vibes in emails
# Examples:
#   - Production: https://festvibes.xyz
#   - Vercel: https://fest-vibes-ai.vercel.app
#   - Development: http://localhost:3000
NEXT_PUBLIC_DOMAIN=http://localhost:3000

# =============================================================================
# EMAIL SERVICE
# =============================================================================
# Resend API Key for sending welcome emails
# Get this from: https://resend.com (3,000 free emails/month)
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM="Fest Vibes Team <onboarding@resend.dev>"

# =============================================================================
# ANALYTICS & A/B TESTING
# =============================================================================
# PostHog Configuration for analytics and feature flags
# Get API key from: https://app.posthog.com/project/settings
# Public key is safe to expose in frontend, private key is for server-side
# Your PostHog public API key (starts with phc_)
NEXT_PUBLIC_POSTHOG_KEY="phc_your_posthog_public_key_here"

# PostHog host URL (default: https://us.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# PostHog URL allowlist (comma-separated list of allowed domains)
NEXT_PUBLIC_POSTHOG_URL_ALLOWLIST="https://festvibes.xyz,https://www.festvibes.xyz,https://app.festvibes.xyz"

# PostHog private API key for server-side operations
POSTHOG_API_KEY="your_posthog_private_api_key_here"

# Payment Integration
# Venmo username (without @) for donation links
NEXT_PUBLIC_VENMO_USERNAME="your_venmo_username"

# Analytics (Optional)
# Google Analytics tracking ID
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
